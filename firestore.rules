rules_version = '2';

// Reglas para el proyecto Firebase de la PÁGINA WEB PÚBLICA de Alburqtex.
// Este es un proyecto separado del Cotizador interno (pagina-web-59681):
// aquí solo se guardan los pedidos que los clientes hacen desde la web,
// nada de Caja ni datos internos.
service cloud.firestore {
  match /databases/{database}/documents {
    // Validación real de formato, no solo "algo escrito" — así nadie puede
    // saltarse el selector de país del formulario escribiendo directo
    // contra Firestore (ej. desde la consola del navegador) y guardar
    // teléfonos inventados. E.164 completo: "+" + 7 a 15 dígitos, el
    // primero del 1 al 9 (ningún código de país real empieza en 0).
    function isValidE164(phone) {
      return phone is string && phone.matches('^\\+[1-9][0-9]{6,14}$');
    }

    // Único correo que puede moderar comentarios (aprobar/rechazar) desde
    // /admin/comentarios en la propia web, en vez de por la consola de
    // Firebase. Coincide con el `email` verificado por Firebase Auth, no
    // con un campo cualquiera — no se puede falsificar.
    function isAdmin() {
      return request.auth != null && request.auth.token.email == 'paulo.abad10200@gmail.com';
    }

    match /pedidos/{pedidoId} {
      // Cada cliente solo puede leer sus propios pedidos.
      allow read: if request.auth != null && request.auth.uid == resource.data.userId;

      // Cada cliente solo puede crear pedidos a su propio nombre, con un
      // teléfono de contacto real (formato E.164 válido).
      allow create: if request.auth != null
        && request.auth.uid == request.resource.data.userId
        && isValidE164(request.resource.data.contactPhone);

      // Nadie puede editar ni borrar un pedido desde la web una vez creado
      // (los cambios de estado los hace el negocio desde la consola de
      // Firebase o, más adelante, una herramienta interna).
      allow update, delete: if false;
    }

    // Perfil propio de cada usuario (usuario, correo, teléfono).
    match /usuarios/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;

      // El correo guardado debe ser el mismo con el que se autenticó (no
      // uno inventado aparte), y el teléfono debe ser un E.164 real.
      allow create: if request.auth != null && request.auth.uid == uid
        && request.resource.data.email == request.auth.token.email
        && isValidE164(request.resource.data.phone);

      allow update, delete: if false;
    }

    // Tablas de búsqueda para poder iniciar sesión con usuario o teléfono
    // en vez de correo. Solo se puede LEER un documento si ya sabes su
    // nombre exacto (no se puede listar/enumerar la colección completa),
    // y solo se puede CREAR el propio la primera vez — nunca sobrescribir
    // uno existente, así nadie puede robarse el usuario/teléfono de otro.
    match /usernames/{username} {
      allow get: if true;
      allow list: if false;
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid;
      allow update, delete: if false;
    }

    match /telefonos/{phone} {
      allow get: if true;
      allow list: if false;
      // La clave del documento es el teléfono mismo (dígitos de su E.164,
      // sin el "+") — también debe tener forma de número real.
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && phone.matches('^[1-9][0-9]{6,14}$');
      allow update, delete: if false;
    }

    // Comentarios/reseñas públicas en la web. Todo comentario nuevo entra
    // en estado "pendiente" — nadie puede publicarse solo. Solo isAdmin()
    // puede aprobarlo (o rechazarlo, borrándolo) desde /admin/comentarios,
    // así ningún comentario ofensivo o spam llega a mostrarse públicamente,
    // sin importar por dónde se haya intentado escribirlo.
    match /comentarios/{comentarioId} {
      // Cualquier visitante puede ver los ya aprobados; el admin además ve
      // los pendientes, para poder revisarlos en /admin/comentarios.
      allow read: if resource.data.status == 'aprobado' || isAdmin();

      // Solo un usuario autenticado, a su propio nombre, siempre en estado
      // "pendiente", con calificación de 1 a 5, sin enlaces (anti-spam), y
      // con una foto opcional guardada como data URI (no hay Storage detrás
      // de este proyecto) — como texto, con un tope de tamaño generoso pero
      // bien por debajo del límite de 1MB por documento de Firestore.
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.status == 'pendiente'
        && request.resource.data.rating is int
        && request.resource.data.rating >= 1
        && request.resource.data.rating <= 5
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 500
        && !request.resource.data.text.matches('(?i).*(https?://|www\\.).*')
        && (!('fotoUrl' in request.resource.data)
            || (request.resource.data.fotoUrl.matches('^data:image/jpeg;base64,.*')
                && request.resource.data.fotoUrl.size() < 700000));

      // Solo el admin puede aprobar, y solo cambiando el campo "status" (no
      // puede reescribir el texto/calificación de alguien más).
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
        && request.resource.data.status == 'aprobado';

      // El autor puede borrar su propio comentario; el admin puede borrar
      // cualquiera (esa es la acción de "rechazar").
      allow delete: if isAdmin() || (request.auth != null && request.auth.uid == resource.data.uid);
    }

    // Contador de intentos fallidos de inicio de sesión, para el captcha al
    // 3er intento, la pausa temporal al 5to y el reseteo forzado al 10mo.
    // Se escribe ANTES de que la persona esté autenticada (así es como
    // funciona un intento fallido), así que por diseño cualquiera puede
    // escribir aquí — nunca datos sensibles, solo un contador y una fecha.
    // Solo se permite subir el contador de a 1 por vez (no saltar a un
    // número arbitrario), y solo el propio dueño de la cuenta, ya
    // autenticado, puede resetearlo a 0 tras iniciar sesión con éxito.
    match /loginAttempts/{email} {
      allow get: if true;
      allow list: if false;
      allow create: if request.resource.data.failedCount == 1;
      allow update: if
        (request.resource.data.failedCount == resource.data.failedCount + 1) ||
        (request.auth != null && request.auth.token.email == email && request.resource.data.failedCount == 0);
      allow delete: if request.auth != null && request.auth.token.email == email;
    }
  }
}
