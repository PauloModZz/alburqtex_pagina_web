# Copia este archivo a ".env" y completa los valores reales.
# Nunca subas el archivo ".env" (con tus llaves reales) a git ni lo compartas públicamente.

# Consola de Firebase -> ⚙️ Configuración del proyecto -> Tus apps -> app web -> "Config"
# (usa un proyecto NUEVO y separado del que ya usa tu Cotizador/pagina_web)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=tu-proyecto.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=tu-proyecto
VITE_FIREBASE_STORAGE_BUCKET=tu-proyecto.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Firebase App Check (protección anti-bots) -> reCAPTCHA v3 site key
# Deja vacío mientras lo configuras; el sitio funciona igual sin esto.
VITE_RECAPTCHA_SITE_KEY=

# Cloudflare Turnstile (captcha visible al 3er intento fallido de login)
# Deja vacío mientras lo configuras; el login funcionará sin este paso extra hasta entonces.
VITE_TURNSTILE_SITE_KEY=

# EmailJS (envía un correo a paulo.abad10200@gmail.com cada vez que entra un
# pedido nuevo). Deja vacío mientras lo configuras; los pedidos se siguen
# guardando igual, solo no llega el aviso por correo hasta entonces.
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=

# EmailJS: segunda plantilla que le confirma el pedido AL CLIENTE (su "To
# Email" es la variable {{client_email}}, no un correo fijo). Opcional: si
# lo dejas vacío, solo te llega el aviso a ti, no la confirmación al cliente.
VITE_EMAILJS_CLIENT_TEMPLATE_ID=

# Telegram: avisa por un bot cuando entra un comentario nuevo pendiente de
# aprobar. Crea el bot hablando con @BotFather en Telegram (comando
# /newbot), y consigue tu chat ID mandándole un mensaje al bot y llamando a
# https://api.telegram.org/bot<TOKEN>/getUpdates. Deja vacío para no usar
# esta función — los comentarios se pueden seguir aprobando desde
# /admin/comentarios sin el aviso automático.
VITE_TELEGRAM_BOT_TOKEN=
VITE_TELEGRAM_CHAT_ID=
